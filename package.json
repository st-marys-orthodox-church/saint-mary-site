{
  "name": "fellowship-event-hall",
  "version": "1.1.0",
  "description": "Fellowship Event Hall — marketing site for the event venue at St. Mary Romanian Orthodox Church.",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "postbuild": "next-sitemap",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "build-prod": "run-s clean build",
    "clean": "rimraf .next out",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "build-types": "tsc --noEmit --pretty",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:check": "node scripts/i18n-sync.mjs --check",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@headlessui/react": "^2.2.0",
    "@mui/icons-material": "^6.2.0",
    "@mui/material": "^6.2.0",
    "@mui/x-date-pickers": "^7.23.0",
    "@sendgrid/mail": "^8.1.4",
    "animate.css": "^4.1.1",
    "classnames": "^2.5.1",
    "i18next": "^26.0.5",
    "moment": "^2.30.1",
    "next": "^15.1.0",
    "next-i18next": "^16.0.5",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "node-ical": "^0.26.0",
    "react": "^19.0.0",
    "react-animation-on-scroll": "^5.1.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.4",
    "react-photo-album": "^3.6.0",
    "yet-another-react-lightbox": "^3.31.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@next/bundle-analyzer": "^15.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.6",
    "lefthook": "^1.10.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "ISC"
}
