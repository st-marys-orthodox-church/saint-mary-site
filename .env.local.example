# St. Mary's Event Hall - Environment Variables
# Copy this file to .env.local for local development
# On Vercel, add these in Settings > Environment Variables

# WhatsApp Business Phone Number
# Format: Country code + number without spaces or special characters
# Example: 14045551234 for US number (404) 555-1234
NEXT_PUBLIC_WHATSAPP_PHONE=14049186165

# Note: NEXT_PUBLIC_ prefix makes this variable available in the browser
# This is required for client-side components like WhatsAppButton

# Private iCal feeds for the parish site
# Add the private Google Calendar iCal URLs you want to aggregate on the
# PROGRAMUL LITURGIC page. These stay server-side and should not use NEXT_PUBLIC_.
PROGRAM_LITURGIC_ICAL_URL=
SAINT_MARY_EVENTS_ICAL_URL=
CALENDARUL_ORTHODOX_ICAL_URL=

# PayPal donation page configuration
NEXT_PUBLIC_PAYPAL_DONATE_BUSINESS=church@saintmaryro.org
NEXT_PUBLIC_PAYPAL_DONATE_ITEM_NAME=Donatii Sala Sociala a Bisericii
NEXT_PUBLIC_PAYPAL_DONATE_CURRENCY=USD
NEXT_PUBLIC_PAYPAL_DONATE_CBT=Biserica Ortodoxa Romana Sfanta Maria
